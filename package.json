  "scripts": {
    "start": "npx nx reset && npm run mkp:serve",
    "assets:generate": "npx tsx scripts/generate-assets.ts",
    "assets:generate:watch": "npx tsx scripts/generate-assets.ts --watch",
    "all:build": "nx run-many --target=build --all",
    "api:serve": "npx nx serve api",
    "api:build": "npx nx build api",
    "db:stop": "npx supabase stop --no-backup",
    "db:reset": "npm run db:stop && npm run db:start",
    "db:start": "npx supabase start",
    "db:status": "npx supabase status",
    "db:clear": "npx tsx supabase/seed/clear-db.ts",
    "db:fetch:prod": "npx tsx ./scripts/fetch-data-prod.ts",
    "db:migration:generate": "cd ./drizzle && npx drizzle-kit generate --config ./config.ts",
    "db:migration:apply": "cd ./drizzle && npx drizzle-kit migrate --config ./config.ts",
    "db:import-bdnb": "node ./scripts/import-snapshot-location-bdnb.js",
    "mkp:build": "npx nx build marketplace",
    "mkp:lint": "nx run marketplace:lint",
    "mkp:serve": "npx nx serve marketplace",
    "nx:graph": "npx nx graph",
    "nx:affected:test": "npx nx affected -t test",
    "nx:affected:show": "nx show projects --affected --type app",
    "nx:affected:build": "npx nx affected -t build --skip-nx-cache --parallel",
    "nx:test:libs": "npx nx run-many -t test --projects=tag:lib",
    "swc:build": "npx nx build showcase",
    "swc:generate:routes": "npx tsx apps/showcase/scripts/generate-routes.ts",
    "swc:lint": "nx run showcase:lint",
    "swc:serve": "npx nx serve showcase",
    "swc:test": "npx nx test showcase",
    "ui:lint": "nx run ui:lint"
  },
