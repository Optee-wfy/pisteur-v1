{
  "name": "@optee/source",
  "version": "0.0.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.13.0"
  },
  "scripts": {
    "assets:generate": "npx tsx scripts/generate-assets.ts",
    "assets:generate:watch": "npx tsx scripts/generate-assets.ts --watch",
    "all:build": "nx run-many --target=build --all",
    "api:serve": "npx nx serve api",
    "api:build": "npx nx build api",
    "web:serve": "npx nx serve web",
    "web:build": "npx nx build web",
    "db:stop": "npx supabase stop --no-backup",
    "db:reset": "npm run db:stop && npm run db:start",
    "db:start": "npx supabase start",
    "db:status": "npx supabase status",
    "db:clear": "npx tsx supabase/seed/clear-db.ts",
    "db:fetch:prod": "npx tsx ./scripts/fetch-data-prod.ts",
    "db:migration:generate": "cd ./drizzle && npx drizzle-kit generate --config ./config.ts",
    "db:migration:apply": "cd ./drizzle && npx drizzle-kit migrate --config ./config.ts",
    "db:import-bdnb": "node ./scripts/import-snapshot-location-bdnb.js",
    "nx:graph": "npx nx graph",
    "nx:affected:test": "npx nx affected -t test",
    "nx:affected:show": "nx show projects --affected --type app",
    "nx:affected:build": "npx nx affected -t build --skip-nx-cache --parallel",
    "nx:test:libs": "npx nx run-many -t test --projects=tag:lib"
  },
  "dependencies": {
    "@amplitude/unified": "latest",
    "@sentry/cli": "^2.41.1",
    "@sentry/node": "^10.32.1",
    "@sentry/profiling-node": "^10.32.1",
    "@supabase/supabase-js": "^2.44.4",
    "@tailwindcss/postcss": "^4.1.4",
    "@terraformer/wkt": "^2.1.2",
    "@trpc/client": "^10.45.2",
    "@trpc/server": "^10.45.2",
    "cors": "^2.8.5",
    "csv-parser": "^3.2.0",
    "drizzle-orm": "^0.32.0",
    "express": "^5.1.0",
    "mailersend": "2.3.0",
    "openai": "^6.9.1",
    "p-limit": "^7.2.0",
    "pino": "^10.2.0",
    "postgres": "^3.4.4",
    "stripe": "20.0.0",
    "superjson": "^2.2.1",
    "tslib": "^2.6.3",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@faker-js/faker": "^9.9.0",
    "@nx/devkit": "22.3.3",
    "@nx/esbuild": "22.3.3",
    "@nx/eslint": "22.3.3",
    "@nx/eslint-plugin": "22.3.3",
    "@nx/js": "22.3.3",
    "@nx/vite": "22.3.3",
    "@nx/vitest": "22.3.3",
    "@nx/web": "22.3.3",
    "@nx/workspace": "22.3.3",
    "@swc-node/register": "~1.9.1",
    "@swc/core": "^1.15.8",
    "@swc/helpers": "~0.5.11",
    "@tailwindcss/typography": "^0.5.15",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/node": "^24.0.0",
    "@types/terraformer__wkt": "^2.0.3",
    "@typescript-eslint/eslint-plugin": "^7.17.0",
    "@typescript-eslint/parser": "^7.17.0",
    "@typescript-eslint/utils": "^7.17.0",
    "@vitest/coverage-v8": "^4.0.16",
    "@vitest/ui": "^4.0.16",
    "autoprefixer": "^10.4.19",
    "dotenv": "^16.5.0",
    "drizzle-kit": "^0.23.0",
    "esbuild": "^0.19.2",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-local-rules": "^3.0.2",
    "eslint-plugin-prettier": "^5.2.1",
    "jiti": "2.4.2",
    "jsdom": "^27.4.0",
    "nx": "22.3.3",
    "postcss": "^8.5.3",
    "prettier": "^3.3.3",
    "prettier-plugin-tailwindcss": "^0.6.6",
    "supabase": "^2.9.6",
    "tailwindcss": "^3.4.17",
    "ts-node": "10.9.1",
    "tsup": "^8.5.0",
    "tsx": "^4.20.3",
    "typescript": "~5.9.0",
    "vite": "7.3.1",
    "vite-plugin-checker": "^0.8.0",
    "vitest": "^4.0.16"
  },
  "overrides": {
    "@supabase/supabase-js": {
      "@supabase/auth-js": "2.61.0"
    },
    "stylus": "git+https://github.com/stylus/stylus.git"
  },
  "optionalDependencies": {
    "@rollup/rollup-linux-x64-gnu": "^4.28.0"
  }
}
