{
  "name": "showcase",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "prefix": "app",
  "sourceRoot": "apps/showcase/src",
  "tags": ["scope:showcase"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{projectRoot}/routes.txt"],
      "inputs": [
        "angular",
        "{projectRoot}/scripts/generate-routes.ts",
        "^production"
      ],
      "configurations": {
        "production": {
          "commands": [
            "npm run swc:generate:routes",
            "npx nx _build showcase --configuration=production"
          ]
        },
        "development": {
          "commands": [
            "npm run swc:generate:routes",
            "npx nx _build showcase --configuration=development"
          ]
        }
      },
      "defaultConfiguration": "production",
      "dependsOn": ["generate:assets"]
    },
    "_build": {
      "executor": "@angular-devkit/build-angular:application",
      "outputs": ["{options.outputPath}"],
      "inputs": ["angular", "{projectRoot}/routes.txt"],
      "options": {
        "outputPath": "dist/apps/showcase",
        "index": "apps/showcase/src/index.html",
        "browser": "apps/showcase/src/main.ts",
        "statsJson": true,
        "tsConfig": "apps/showcase/tsconfig.app.json",
        "inlineStyleLanguage": "scss",
        "assets": [
          {
            "glob": "**/*",
            "input": "libs/public"
          }
        ],
        "styles": ["apps/showcase/src/styles.scss"],
        "scripts": [],
        "server": "apps/showcase/src/main.server.ts",
        "prerender": {
          "routesFile": "apps/showcase/routes.txt"
        }
      },
      "configurations": {
        "production": {
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "950kb",
              "maximumError": "1500kb"
            },
            {
              "type": "anyComponentStyle",
              "maximumWarning": "2kb",
              "maximumError": "4kb"
            }
          ],
          "outputHashing": "all",
          "sourceMap": false,
          "optimization": true,
          "extractLicenses": true,
          "namedChunks": false
        },
        "development": {
          "optimization": false,
          "extractLicenses": false,
          "sourceMap": true,
          "watch": true,
          "preserveSymlinks": true
        }
      },
      "defaultConfiguration": "production"
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "commands": ["npx eslint apps/showcase --ext .ts --fix"]
      }
    },
    "serve": {
      "executor": "@angular-devkit/build-angular:dev-server",
      "options": {
        "poll": 2000
      },
      "configurations": {
        "production": {
          "buildTarget": "showcase:_build:production"
        },
        "development": {
          "buildTarget": "showcase:_build:development",
          "port": 4400
        },
        "minimal": {
          "buildTarget": "showcase:_build:development",
          "watch": false,
          "liveReload": false,
          "hmr": false
        }
      },
      "defaultConfiguration": "development"
    },
    "serve-static": {
      "executor": "@nx/web:file-server",
      "options": {
        "buildTarget": "showcase:build",
        "port": 4300,
        "staticFilePath": "dist/apps/showcase/browser",
        "spa": true
      }
    },
    "deploy": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "firebase --non-interactive deploy --only hosting:showcase-target --force --config firebase.json"
        ],
        "parallel": true
      },
      "dependsOn": ["lint", "build"]
    },
    "deploy:preview": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "firebase --non-interactive hosting:channel:deploy $FIREBASE_PREVIEW_NAME --only showcase-target --no-authorized-domains | tee firebase_showcase_deploy_log.txt"
        ],
        "parallel": true
      },
      "dependsOn": ["lint", "build"]
    }
  }
}
