{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "namedInputs": {
    "default": ["{projectRoot}/**/*"],
    "production": [
      "default",
      "!{projectRoot}/.eslintrc.json",
      "!{projectRoot}/**/?(*.)+(spec|test).[jt]s?(x)?(.snap)",
      "!{projectRoot}/**/tsconfig.spec.json",
      "!{projectRoot}/**/jest.config.ts",
      "!{projectRoot}/**/*.cy.ts",
      "!{projectRoot}/**/cypress.config.ts",
      "!{projectRoot}/tsconfig.spec.json",
      "!{projectRoot}/src/test-setup.[jt]s"
    ],
    "vite": [
      "production",
      "{workspaceRoot}/node_modules/vite/**"
    ]
  },
  "targetDefaults": {
    "@nx/eslint:lint": {
      "cache": true,
      "inputs": [
        "default",
        "{workspaceRoot}/.eslintrc.json",
        "{workspaceRoot}/.eslintignore",
        "{workspaceRoot}/eslint.config.js"
      ]
    },
    "@nx/js:tsc": {
      "cache": true,
      "dependsOn": ["^build"],
      "inputs": ["production", "^production"]
    },
    "build": {
      "dependsOn": [
        {
          "projects": "{dependencies}",
          "target": "build",
          "params": "forward"
        }
      ]
    },
    "generate:assets": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx tsx scripts/generate-assets.ts"
      },
      "cache": true,
      "inputs": [
        "{workspaceRoot}/libs/public/assets/**/*",
        "{workspaceRoot}/scripts/generate-assets.ts"
      ],
      "outputs": [
        "{workspaceRoot}/libs/shared/constants/src/lib/assets.constant.ts"
      ]
    }
  },
  "plugins": [],
  "generators": {
    "@nx/web:application": {
      "style": "css",
      "linter": "eslint",
      "unitTestRunner": "vitest",
      "e2eTestRunner": "none"
    }
  }
}
